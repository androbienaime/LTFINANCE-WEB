# Copiez ce fichier en .env (développement) ou .env.production (build de production)
# URL de base de l'API Laravel, sans slash final. Laissez vide pour le mode démo (appels simulés).
VITE_API_URL=127.0.0.1:8000/api

# Chemins des routes (à adapter à vos routes Laravel)
VITE_LOGIN_PATH=/customer/login
VITE_CONTACT_PATH=/public/contact
VITE_NEWSLETTER_PATH=/public/newsletter
